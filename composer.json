{
    "name": "linkrobins/op",
    "description": "Adds an OP label next to the original poster's name on their posts in a discussion.",
    "type": "flarum-extension",
    "keywords": ["discussion", "op", "label"],
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0",
        "php": "^8.2"
    },
    "authors": [
        {
            "name": "linkrobins",
            "email": "support@kbexit.vet"
        }
    ],
    "autoload": {
        "psr-4": {
            "LinkRobins\\Op\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins OP",
            "category": "discussion",
            "icon": {
                "name": "fas fa-crown",
                "backgroundColor": "#1a2535",
                "color": "#07adcc"
            }
        }
    }
}
